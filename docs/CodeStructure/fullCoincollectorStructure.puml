@startuml coincollector_structure
title CoinCollector — vereinfachte Architektur (Spring Boot)

skinparam packageStyle rectangle
skinparam linetype ortho
left to right direction

actor Browser

package "Web Layer" {
	component "Embedded Tomcat\n(HTTP Server)" as Tomcat
	package "Frontend / Static" {
		[index.html\n/static/*] as StaticFiles
	}
	package "Controller / Handler (Web)" {
		[REST Controllers / Handlers] as Controllers
	}
}

package "Application Layer" {
	component "ApplicationContext\n(Spring Boot)" as AppCtx
	component "SessionManager\n(session bean)" as SessionManager
	component "SecurityFilter\n(SessionFilter, AuthEntryPoint)" as SecurityFilter
	component "SqliteInitializer\n(schema init)" as SqliteInitializer
	package "Service" {
		[Application Services] as Services
	}
}

package "Persistence Layer" {
	package "Repository (SQLite)" {
		[SQLite Repositories] as Repos
	}
	database "SQLite DB\n(coincollector.db)" as SQLite
}

Browser --> Tomcat : HTTP request
Tomcat --> StaticFiles : serves static content
Tomcat --> Browser : HTTP response
Tomcat --> Controllers : forwards requests
Controllers --> Services
Services --> Repos
Repos --> SQLite

AppCtx --> Controllers
AppCtx --> Services
AppCtx --> Repos
AppCtx --> SecurityFilter
AppCtx --> SessionManager
AppCtx --> SqliteInitializer

Tomcat ..> AppCtx : embedded

@enduml