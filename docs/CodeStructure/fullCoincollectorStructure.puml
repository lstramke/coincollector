@startuml coincollector_structure

left to right direction
skinparam linetype ortho
skinparam packageStyle rectangle
skinparam shadowing false
skinparam roundcorner 12
skinparam defaultFontName Arial
skinparam defaultFontSize 11
skinparam componentStyle rectangle
skinparam componentFontSize 10
skinparam componentPadding 12
skinparam packageFontSize 12
skinparam packagePadding 16
skinparam actorFontSize 11
skinparam arrowFontSize 8
skinparam noteFontSize 10
skinparam nodesep 35
skinparam ranksep 45

skinparam actor {
    BackgroundColor #E8F1FB
    BorderColor #356A9A
}

skinparam package {
    BackgroundColor #F8FAFC
    BorderColor #64748B
    FontColor #1E293B
    FontStyle bold
}

skinparam component {
    BackgroundColor #FFFFFF
    BorderColor #475569
    FontColor #1E293B
}

skinparam database {
    BackgroundColor #FFF7ED
    BorderColor #C2410C
    FontColor #7C2D12
}

skinparam note {
    BackgroundColor #FFFBEB
    BorderColor #D97706
    FontColor #78350F
}

actor "Browser" as Browser

package "Web Layer" #E8F1FB {
    component "Embedded Tomcat\nHTTP server" as Tomcat #DBEAFE

    package "Frontend / Static" #EFF6FF {
        component "index.html\n/static/*" as StaticFiles
    }

    package "Controller / Handler"  as Controllers #EFF6FF {
    }
}

package "Application Layer" #ECFDF5 {
    component "ApplicationContext\nSpring Boot" as AppCtx #D1FAE5
    component "SecurityFilterChain" as SecurityFilter #D1FAE5
    component "Application\nservices" as Services #D1FAE5
}

package "Persistence Layer" #FFF7ED {
    component "SQLite\nrepositories" as Repos #FFEDD5
    component "Flyway" as Flyway #FFEDD5
    database "SQLite database\ncoincollector.db" as SQLite
}

Browser --> Tomcat
Tomcat --> Browser
Tomcat -> StaticFiles
Tomcat --> Controllers

Controllers --> Services
Services --> Repos
Repos --> SQLite
Flyway --> SQLite : schema migration

AppCtx ..> SecurityFilter
AppCtx ...> Tomcat
AppCtx ...> Controllers
AppCtx ..> Services
AppCtx ..> Repos
AppCtx ..> Flyway

@enduml
